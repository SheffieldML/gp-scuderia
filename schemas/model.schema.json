{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sheffieldml.github.io/gp-scuderia/schemas/model.schema.json",
  "title": "SheffieldML GP model interchange",
  "description": "Draft 0.1 — YAML primary; this schema validates the shared tree. Framework-neutral: parameters are natural, positive and untransformed. Extension fields must be prefixed x-.",
  "type": "object",
  "required": ["schema_version", "type", "kernel", "likelihood"],
  "properties": {
    "schema_version": { "type": "string", "const": "0.1" },
    "type": { "type": "string", "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)+$" },
    "input_dim": { "type": "integer", "minimum": 1 },
    "output_dim": { "type": "integer", "minimum": 1 },
    "approximation": {
      "type": "string",
      "enum": ["ftc", "dtc", "dtcvar", "fitc", "pitc"]
    },
    "sparse_linalg": {
      "type": "string",
      "enum": ["lq", "stable", "legacy"]
    },
    "inducing_inputs": { "$ref": "#/$defs/matrix" },
    "kernel": { "$ref": "#/$defs/kernelNode" },
    "mean": { "$ref": "#/$defs/meanNode" },
    "normalizer": { "$ref": "#/$defs/normalizerNode" },
    "likelihood": { "$ref": "#/$defs/likelihoodNode" },
    "data": {
      "type": "object",
      "required": ["X", "Y"],
      "properties": {
        "X": { "$ref": "#/$defs/matrix" },
        "Y": { "$ref": "#/$defs/matrix" }
      },
      "additionalProperties": false
    }
  },
  "patternProperties": { "^x-": {} },
  "additionalProperties": false,
  "allOf": [
    { "not": { "required": ["mean", "normalizer"] } },
    {
      "if": {
        "required": ["approximation"],
        "properties": { "approximation": { "enum": ["dtc", "dtcvar", "fitc", "pitc"] } }
      },
      "then": { "required": ["inducing_inputs"] }
    },
    {
      "if": { "required": ["sparse_linalg"] },
      "then": {
        "required": ["approximation"],
        "properties": { "approximation": { "enum": ["dtc", "dtcvar", "fitc", "pitc"] } }
      }
    }
  ],
  "$defs": {
    "meanNode": {
      "description": "Prior mean on the original target scale. Absent means zero. Exclusive with normalizer in 0.1.",
      "type": "object",
      "required": ["type", "value"],
      "properties": {
        "type": { "const": "mean.constant" },
        "value": { "type": "number" }
      },
      "patternProperties": { "^x-": {} },
      "additionalProperties": false
    },
    "normalizerNode": {
      "description": "The model was fitted to (y - mean) / std. Log likelihood and predictions are reported on the original scale, including the -n log(std) Jacobian term. Absent means no transform.",
      "type": "object",
      "oneOf": [
        {
          "required": ["type", "mean"],
          "properties": {
            "type": { "const": "normalizer.center" },
            "mean": { "type": "number" }
          },
          "patternProperties": { "^x-": {} },
          "additionalProperties": false
        },
        {
          "required": ["type", "mean", "std"],
          "properties": {
            "type": { "const": "normalizer.standardize" },
            "mean": { "type": "number" },
            "std": { "type": "number", "exclusiveMinimum": 0 }
          },
          "patternProperties": { "^x-": {} },
          "additionalProperties": false
        }
      ]
    },
    "matrix": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "number" }
      }
    },
    "positive": { "type": "number", "exclusiveMinimum": 0 },
    "prior": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string" }
      },
      "additionalProperties": true
    },
    "kernelNode": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "pattern": "^kern\\.[a-z0-9_]+$" },
        "parts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/kernelNode" }
        },
        "variance": { "$ref": "#/$defs/positive" },
        "lengthscale": {
          "oneOf": [
            { "$ref": "#/$defs/positive" },
            { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/positive" } }
          ]
        },
        "ARD": { "type": "boolean" },
        "output_dim": { "type": "integer", "minimum": 1 },
        "W": { "$ref": "#/$defs/matrix" },
        "kappa": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/positive" } },
        "active_dims": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 0 }
        },
        "priors": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/prior" }
        }
      },
      "patternProperties": { "^x-": {} },
      "additionalProperties": true,
      "allOf": [
        {
          "if": { "properties": { "type": { "enum": ["kern.add", "kern.prod"] } }, "required": ["type"] },
          "then": { "required": ["parts"] }
        },
        {
          "if": { "properties": { "type": { "const": "kern.coregionalize" } }, "required": ["type"] },
          "then": {
            "description": "B = W W' + diag(kappa), indexed by the integer in the single active column. W is output_dim x rank.",
            "required": ["output_dim", "W", "kappa", "active_dims"],
            "properties": { "active_dims": { "maxItems": 1 } }
          }
        }
      ]
    },
    "likelihoodNode": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "pattern": "^likelihoods\\.[a-z0-9_]+$" },
        "variance": {
          "oneOf": [
            { "$ref": "#/$defs/positive" },
            { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/positive" } }
          ]
        },
        "output_index_column": { "type": "integer", "minimum": 0 },
        "priors": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/prior" }
        }
      },
      "patternProperties": { "^x-": {} },
      "additionalProperties": true,
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "likelihoods.mixed_gaussian" } }, "required": ["type"] },
          "then": {
            "description": "One Gaussian noise variance per output; the output index is the integer in data.X column output_index_column.",
            "required": ["variance", "output_index_column"],
            "properties": { "variance": { "type": "array" } }
          },
          "else": { "properties": { "variance": { "type": "number" } } }
        }
      ]
    }
  }
}
